# Prefer the composition root's provider when it already supplies lexec.
if(TARGET lexec::lexec)
    get_target_property(lrclexec_lexec_provider lexec::lexec ALIASED_TARGET)
    if(NOT lrclexec_lexec_provider STREQUAL "lrclexec::lexec_headers")
        set_property(TARGET lrclexec::lexec_headers PROPERTY INTERFACE_INCLUDE_DIRECTORIES "")
        set_property(TARGET lrclexec::lexec_headers PROPERTY INTERFACE_LINK_LIBRARIES lexec::lexec)
    endif()
elseif(@LRCLEXEC_BUNDLE_LEXEC_HEADERS@)
    # <execution>'s backend depends on the consumer's standard library/toolchain.
    function(lrclexec_check_execution_backend)
        set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
        if(NOT CMAKE_CXX_STANDARD)
            set(CMAKE_CXX_STANDARD 17)
        endif()
        include(CheckCXXSourceCompiles)
        check_cxx_source_compiles("#include <execution>\n#ifndef _PSTL_PAR_BACKEND_TBB\n#error not TBB\n#endif\nint main() {}"
            LRCLEXEC_STD_EXECUTION_USES_TBB)
    endfunction()
    lrclexec_check_execution_backend()
    if(LRCLEXEC_STD_EXECUTION_USES_TBB)
        find_dependency(TBB CONFIG)
        set_property(TARGET lrclexec::lexec_headers APPEND PROPERTY INTERFACE_LINK_LIBRARIES TBB::tbb)
    endif()
    add_library(lexec::lexec ALIAS lrclexec::lexec_headers)
endif()
