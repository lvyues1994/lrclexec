Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Enabled: true
  Name: root
  Global Options:
    Background Color: 35; 39; 46
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Static Map
      Enabled: true
      Alpha: 0.8
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      Color Scheme: map
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: true
      Alpha: 0.4
      Topic:
        Value: /global_costmap/costmap
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      Color Scheme: costmap
    - Class: rviz_default_plugins/LaserScan
      Name: Laser Scan
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 5
      Size (m): 0.035
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 96; 64
    - Class: rviz_default_plugins/Path
      Name: Planned Path
      Enabled: true
      Topic:
        Value: /plan
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 5
      Color: 40; 230; 130
      Line Style: Billboards
      Line Width: 0.045
    - Class: rviz_default_plugins/Axes
      Name: Robot base_link
      Enabled: true
      Reference Frame: base_link
      Length: 0.45
      Radius: 0.035
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: AMCL Pose
      Enabled: true
      Topic:
        Value: /amcl_pose
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
      Shape: Arrow
      Color: 70; 160; 255
      Shaft Length: 0.35
      Shaft Radius: 0.03
      Head Length: 0.12
      Head Radius: 0.08
    - Class: rviz_default_plugins/Pose
      Name: Last Started Target
      Enabled: true
      Topic:
        Value: /navigation/active_goal
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
      Shape: Arrow
      Color: 240; 200; 40
      Shaft Length: 0.45
      Shaft Radius: 0.025
      Head Length: 0.15
      Head Radius: 0.07
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetGoal
      Topic: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: map
      Scale: 75
      X: 2
      Y: 0
      Angle: 0
Window Geometry:
  Width: 1100
  Height: 850
  X: 20
  Y: 40
